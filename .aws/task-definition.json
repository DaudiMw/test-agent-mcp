{
  "family": "learning-plan-mcp-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::916633759822:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "learning-plan-app",
      "image": "123456789012.dkr.ecr.us-east-2.amazonaws.com/learning-plan-mcp:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "mcp-sse-port"
        }
      ],
      "secrets": [
        {
          "name": "MCP_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:916633759822:parameter/mcp/learning_plan_api_key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/learning-plan-mcp",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}